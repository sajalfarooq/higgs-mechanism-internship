Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Cross", " ", "section", " ", "in", " ", "pb", " ", "as", " ", "a", " ", 
     "function", " ", "of", " ", "sqrt", 
     RowBox[{"(", "s", ")"}]}], ",", 
    RowBox[{"reusing", " ", "the", " ", "analytic", " ", "sigmaTotal"}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sigmaPbPlot", "[", 
      RowBox[{"sqrtS_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"sigmaTotal", "/.", " ", "numericalRules"}], "/.", " ", 
        RowBox[{"s", "->", 
         RowBox[{"sqrtS", "^", "2"}]}]}], ")"}], "*", "GeVtoPb"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Threshold", " ", "energy"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thresholdE", "=", 
     RowBox[{"mZnum", "+", "mHnum"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Main", " ", 
     RowBox[{"figure", ":", 
      RowBox[{"sigma", 
       RowBox[{"(", 
        RowBox[{"sqrt", 
         RowBox[{"(", "s", ")"}]}], ")"}], " ", "from", " ", "220", " ", "to",
        " ", "1000", " ", "GeV"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"figSigma", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"sigmaPbPlot", "[", "rs", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"rs", ",", "220", ",", "1000"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", "All"}], "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<\\!\\(\\*SqrtBox[\\(s\\)]\\) (GeV)\>\"", 
          ",", "\"\<\[Sigma](\\!\\(\\*SuperscriptBox[\\(e\\), \
\\(+\\)]\\)\\!\\(\\*SuperscriptBox[\\(e\\), \\(-\\)]\\)\[Rule]ZH) (pb)\>\""}],
          "}"}]}], ",", 
       RowBox[{"GridLines", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "thresholdE", "}"}], ",", "None"}], "}"}]}], ",", 
       RowBox[{"GridLinesStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Red", ",", "Dashed"}], "]"}]}], ",", 
       RowBox[{"Epilog", "->", 
        RowBox[{"{", 
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<threshold \\!\\(\\*SubscriptBox[\\(m\\), \
\\(Z\\)]\\)+\\!\\(\\*SubscriptBox[\\(m\\), \\(H\\)]\\)\>\"", ",", "12"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"thresholdE", "+", "60"}], ",", "0.02"}], "}"}]}], "]"}],
          "}"}]}], ",", 
       RowBox[{"PlotStyle", "->", "Thick"}], ",", 
       RowBox[{"ImageSize", "->", "500"}]}], "]"}]}], ";"}], "\n", "figSigma",
    "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Locate", " ", "the", " ", "peak", " ", "numerically"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"peak", "=", 
    RowBox[{"NMaximize", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"sigmaPbPlot", "[", "rs", "]"}], ",", 
        RowBox[{"230", "<", "rs", "<", "300"}]}], "}"}], ",", "rs"}], "]"}]}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Log", "-", 
     RowBox[{"log", " ", "plot", " ", "to", " ", "exhibit", " ", 
      RowBox[{
       RowBox[{"the", "~", "1"}], "/", "s"}], " ", "falloff", " ", "at", " ", 
      "high", " ", "energy"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"figLogLog", "=", 
     RowBox[{"LogLogPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sigmaPbPlot", "[", "rs", "]"}], ",", 
         RowBox[{
          RowBox[{"sigmaPbPlot", "[", "500", "]"}], "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"500", "/", "rs"}], ")"}], "^", "2"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"rs", ",", "300", ",", "3000"}], "}"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<\\!\\(\\*SqrtBox[\\(s\\)]\\) (GeV)\>\"", 
          ",", "\"\<\[Sigma] (pb)\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<exact\>\"", 
          ",", "\"\<\[Proportional]1/s reference\>\""}], "}"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Dashed"}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "500"}]}], "]"}]}], ";"}], "\n", 
   "figLogLog", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Angular", " ", "distribution", " ", 
     RowBox[{"(", "normalized", ")"}], " ", "at", " ", "three", " ", 
     "energies"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"figAngular", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"dSigmadOmega", "/.", " ", "numericalRules"}], "/.", 
              " ", 
              RowBox[{"s", "->", 
               RowBox[{"rs", "^", "2"}]}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"sigmaTotal", "/.", " ", "numericalRules"}], "/.", " ", 
              RowBox[{"s", "->", 
               RowBox[{"rs", "^", "2"}]}]}], ")"}]}], "*", "2", "*", "Pi"}], ",", 
          RowBox[{"{", 
           RowBox[{"rs", ",", 
            RowBox[{"{", 
             RowBox[{"250", ",", "350", ",", "500"}], "}"}]}], "}"}]}], "]"}],
         "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"cth", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<cos\[Theta]\>\"", 
          ",", "\"\<(1/\[Sigma]) d\[Sigma]/dcos\[Theta]\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<250 GeV\>\"", ",", "\"\<350 GeV\>\"", 
          ",", "\"\<500 GeV\>\""}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "500"}]}], "]"}]}], ";"}], "\n", 
   "figAngular", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.995012351806406*^9, 3.995012353159029*^9}, 
   3.995012614906023*^9, 3.995012657759926*^9},
