      SuperscriptBox["s", "2"]}], ")"}]}], 
   RowBox[{"192", " ", "\[Pi]", " ", 
    SuperscriptBox["cw", "2"], " ", 
    SuperscriptBox["s", "2"], " ", 
    SuperscriptBox["vev", "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["mZ", "2"], "-", "s"}], ")"}], "2"]}]], 
